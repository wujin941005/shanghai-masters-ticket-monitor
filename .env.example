# 公开个人版支持 Bark、Server酱、单 UID WxPusher。
# 可只配置一种或多种；不填写时自动使用所有已成功配置的渠道。
# NOTIFY_CHANNELS=bark,serverchan,wxpusher

# Bark：适合 iPhone / iPad / Mac。
# BARK_KEY=https://api.day.app/your_key_here

# Server酱：在 https://sct.ftqq.com/sendkey 复制个人 SendKey。
# SERVERCHAN_SENDKEY=SCTxxxxxxxx

# WxPusher：创建标准应用并填写自己的 AppToken 和一个 UID。
# 公开个人版不接受多个 UID、Topic 或订单用户库。
# WXPUSHER_APP_TOKEN=AT_xxxxxxxxx
# WXPUSHER_UID=UID_xxxxxxxxx

# 默认都使用官方支付宝小程序跳转页：票星球跳自身小程序，
# 久事/莓塔跳久事体育支付宝小程序首页（2021003127624300）。
# BUY_URL_MODE=app  # 票星球改原生 App
# BUY_URL_MODE=web  # 久事/莓塔回官方网页，票星球用活动网页

# 票档/库存刷新周期；默认 15 秒，最低 5 秒。
MONITOR_INTERVAL=15

# 可选：售票入口过滤。meta 与 juss 使用同一份久事库存。
# CHANNELS=juss,piaoxingqiu

# 必填：选择个人要监控的场次，多个关键词用逗号分隔。
# 默认半决赛和决赛约 14 个跨平台入口，低于个人版 20 个入口上限。
MATCH=10月17日,10月18日

# 可选：只监控完整名称匹配的票档；不填写则监控所选场次的全部票档。
# GRADES=S,A+,A,B
